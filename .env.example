# MySQL container
MYSQL_DATABASE=workhub
MYSQL_USER=workhub_user
MYSQL_PASSWORD=change_this_application_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# PHP application connection
DB_HOST=db
DB_PORT=3306
DB_NAME=workhub
DB_USER=workhub_user
DB_PASSWORD=change_this_application_password

# Application environment
APP_ENV=local
APP_PORT=8080

# Initial administrator
ADMIN_BOOTSTRAP_HABILITADO=true
ADMIN_INICIAL_NOME=Administrador local
ADMIN_INICIAL_EMAIL=admin@admin.com
ADMIN_INICIAL_SENHA=altere_esta_senha_local

# Session and reverse proxy
SESSAO_COOKIE_SECURE=false
PROXY_REVERSO_CONFIAVEL=false

# Login rate limiting
APP_CHAVE_RATE_LIMIT=substitua_por_uma_chave_aleatoria_longa_e_unica

# Produção com compose.prod.yaml: domínio público já apontado para a EC2.
WORKHUB_DOMINIO=workhub.exemplo.com
