# Copie este arquivo para .env.demo somente na EC2 de demonstração.
# Nunca versione o arquivo preenchido nem use senhas reais.
MYSQL_DATABASE=workhub
MYSQL_USER=workhub_user
MYSQL_PASSWORD=substitua_por_uma_senha_longa
MYSQL_ROOT_PASSWORD=substitua_por_outra_senha_longa

DB_HOST=db
DB_PORT=3306
DB_NAME=workhub
DB_USER=workhub_user
DB_PASSWORD=substitua_por_uma_senha_longa

# Gere com: openssl rand -hex 32
APP_CHAVE_RATE_LIMIT=substitua_por_uma_chave_aleatoria_longa_e_unica
